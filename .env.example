# Modèle de configuration — copiez ce fichier en « .env » pour le développement,
# et reportez les mêmes variables dans Vercel (Settings → Environment Variables)
# pour la production. Voir la section « Déploiement » du README.
#   cp .env.example .env
#
# Aucune valeur secrète ne doit être committée : .env est exclu par .gitignore,
# ce modèle-ci est versionné.
#
# Récapitulatif des variables à déclarer sur Vercel (Production + Preview) :
#   DATABASE_URL, DIRECT_URL, AUTH_SECRET, NEXT_PUBLIC_SITE_URL, CRON_SECRET,
#   ALLSPORTS_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   RESEND_API_KEY, RESEND_WEBHOOK_SECRET,
#   RESEND_FROM_EMAIL, RESEND_FROM_NAME, BLOB_READ_WRITE_TOKEN.
#   (SQLITE_DATABASE_URL, RESEND_BASE_URL et NEON_DIRECT_URL sont réservées au
#   poste local ; API_FOOTBALL_KEY n'est utile que si le repli API-Football est
#   réactivé.)

# ---------------------------------------------------------------------------
# Base de données — PostgreSQL (WP12a), Neon en production
# ---------------------------------------------------------------------------
#
# En local : conteneur Docker
#   docker run -d --name promptsport-pg -e POSTGRES_USER=promptsport \
#     -e POSTGRES_PASSWORD=promptsport -e POSTGRES_DB=promptsport \
#     -p 5432:5432 -v promptsport-pgdata:/var/lib/postgresql/data postgres:17-alpine
#
# Neon fournit deux chaînes TCP (console → « Connect ») :
#   — « pooled » : hôte `ep-…-pooler.….neon.tech`, à utiliser par l'application
#                  (les fonctions serverless ouvrent beaucoup de connexions
#                  courtes : le pooler les multiplexe) ;
#   — « direct » : hôte `ep-….neon.tech`, à utiliser par les commandes Prisma
#                  (migrations, introspection) et par les scripts qui
#                  exécutent des ordres de session — voir DIRECT_URL.
# Les deux exigent `?sslmode=require`.
#
# N'utilisez PAS une URL `prisma+postgres://` (Accelerate hébergé, ou le serveur
# local de `prisma dev`) : ce n'est pas du PostgreSQL sur TCP. La CLI Prisma la
# lirait, mais `@prisma/adapter-pg`, les scripts `pg-sync` (suites de tests,
# seed des thèmes) et `prisma db execute` la refusent explicitement.
DATABASE_URL="postgresql://promptsport:promptsport@localhost:5432/promptsport?schema=public"
# Production (Neon, chaîne pooled) :
# DATABASE_URL="postgresql://user:motdepasse@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Chaîne directe, utilisée par la CLI Prisma (migrations, introspection) et par
# `npm run db:seed:themes` : prisma.config.ts la prend **en priorité** dès
# qu'elle est renseignée, sinon il retombe sur DATABASE_URL. Aucune substitution
# manuelle n'est donc nécessaire — `npm run db:deploy` suffit.
# Contrôle avant déploiement : node scripts/check-prisma-postgres.cjs
DIRECT_URL=""
# Optional application override when DATABASE_URL is managed by an integration.
# Use the complete pooled connection string. Migrations still use DIRECT_URL.
APP_DATABASE_URL=""
# Production : DIRECT_URL="postgresql://user:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Source de la migration de données SQLite → PostgreSQL (WP12a) uniquement.
# À ne pas déclarer sur Vercel : le schéma n'utilise plus SQLite.
SQLITE_DATABASE_URL="file:./prisma/dev.db"

# Cible de `scripts/migrate-local-to-neon.cjs`, en simulation comme en écriture.
# Chaîne **directe** Neon (hôte `ep-….neon.tech`, sans `-pooler`) : les
# migrations ont besoin d'une connexion non poolée.
# Ce script ne lit volontairement ni DIRECT_URL ni DATABASE_URL (ils visent la
# base de développement) : la cible doit être explicite.
# NEON_DIRECT_URL="postgresql://user:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5) — secret de signature des JWT
# ---------------------------------------------------------------------------
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ou       : openssl rand -base64 32
# L'application lit AUTH_SECRET ; Auth.js accepte aussi NEXTAUTH_SECRET (ancien
# nom, conservé pour compatibilité) mais ce projet n'en dépend pas.
AUTH_SECRET=""

# OAuth facultatif : renseigner les deux valeurs pour activer le fournisseur.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Facultatif : avec `trustHost: true` (src/lib/auth.ts), l'URL publique est
# déduite de la requête, donc AUTH_URL / NEXTAUTH_URL ne sont pas nécessaires
# sur Vercel. Les définir ne peut que forcer une URL erronée en Preview.
# AUTH_URL="https://votre-projet.vercel.app"
# NEXTAUTH_URL="https://votre-projet.vercel.app"

# ---------------------------------------------------------------------------
# URL publique du site : metadataBase, URL canonique, JSON-LD, liens des e-mails
# ---------------------------------------------------------------------------
# En local : http://localhost:3002 (le port 3000 est occupé par un autre projet).
# Sur Vercel : l'URL de production, sans barre oblique finale — elle sert aussi
# de base aux liens de confirmation/désabonnement de la newsletter.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# ---------------------------------------------------------------------------
# API-Football via API-Sports direct — compétitions, équipes et matchs
# ---------------------------------------------------------------------------
# Clé : https://dashboard.api-football.com — Account → My Access
# 100 requêtes / jour ; saisons gratuites limitées. Voir le README WP19a.
# Conservée comme service de repli (src/lib/api-football-sync.ts).
API_FOOTBALL_KEY=""
# Optionnel : année de début de saison (jamais de repli automatique).
# API_FOOTBALL_SEASON="2026"

# ---------------------------------------------------------------------------
# AllSportsApi (RapidAPI) — fournisseur retenu au WP19a-bis
# ---------------------------------------------------------------------------
# Clé : https://rapidapi.com/fluis.lacasse/api/allsportsapi2 → « Subscribe »
# (plan Basic gratuit : 100 requêtes/jour, 5 requêtes/seconde, scores en direct).
# L'accès passe par l'hôte RapidAPI : allsportsapi.com et apiv2.allsportsapi.com
# rejettent cette clé.
# Validation : `node scripts/test-allsports.cjs`
# Import sans écriture : `npx tsx scripts/sync-football.ts --dry-run`
ALLSPORTS_API_KEY=""
# Optionnel : saison à importer (« 26/27 » ou 2026) — par défaut la plus récente.
# ALLSPORTS_SEASON="26/27"

# Scores en direct FotMob — TEST LOCAL UNIQUEMENT (endpoint non officiel, non
# autorisé en production). « 1 » alimente le bandeau de l'accueil avec FotMob
# sous `next dev` ; un build de production ignore ce réglage.
FOTMOB_LIVE=""
# Optionnel : pages de matchs de part et d'autre d'aujourd'hui (30 par page et
# par sens ; 4 par défaut).
# ALLSPORTS_MATCH_PAGES="4"

# ---------------------------------------------------------------------------
# Stripe — abonnements premium
# ---------------------------------------------------------------------------
# Clés de TEST en développement (elles commencent par sk_test_ / pk_test_).
# Webhook : `stripe listen --forward-to localhost:3002/api/webhooks/stripe`
# La configuration des webhooks de production relève du WP12d.
# Seule la clé secrète est lue par l'application : le paiement passe par une
# session Stripe Checkout créée côté serveur, qui renvoie vers une page hébergée.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Héritée du WP7b : plus lue par le code (aucun Stripe.js côté navigateur).
# Conservée pour la checklist de déploiement historique ; peut rester vide.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Resend — envoi des campagnes de newsletter (WP11b)
# ---------------------------------------------------------------------------
# Clé : https://resend.com/api-keys. Laisser RESEND_API_KEY vide désactive
# l'envoi (l'application le signale sans planter).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="PromptSport"
# Secret de signature des webhooks Resend (dashboard Resend > Webhooks).
RESEND_WEBHOOK_SECRET=""
# Optionnelle : URL de l'API Resend, réservée aux tests hors ligne (serveur
# factice). Ne pas déclarer sur Vercel.
# RESEND_BASE_URL="http://127.0.0.1:3100"

# ---------------------------------------------------------------------------
# Stockage des images de couverture — Vercel Blob (production)
# ---------------------------------------------------------------------------
# Le système de fichiers d'une fonction Vercel est en lecture seule : en
# production, `uploadImage` envoie donc le fichier dans Vercel Blob et renvoie
# l'URL publique du blob. Le store doit être **public** (l'URL est affichée par
# next/image, dont l'hôte est autorisé dans next.config.ts).
#
# En développement, laisser la variable vide : l'action écrit alors dans
# public/uploads/ et renvoie un chemin relatif (aucun compte Blob nécessaire).
# Sur Vercel : Project → Storage → Blob, puis copier le jeton de lecture/écriture.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Secret des tâches planifiées (WP11d)
# ---------------------------------------------------------------------------
# Protège /api/cron/newsletter : à présenter en en-tête
# « Authorization: Bearer … ». Le cron sportif refuse les secrets en URL.
#
# Sur Vercel, définir CRON_SECRET suffit : les appels du planificateur ajoutent
# automatiquement cet en-tête. Générer avec `openssl rand -base64 32`.
# Le cron quotidien est déclaré dans vercel.json.
CRON_SECRET=""
# WP19b : définir le même secret CRON_SECRET dans Vercel et GitHub Actions.
# GitHub > Settings > Secrets and variables > Actions : secret CRON_SECRET,
# variable SITE_URL = adresse HTTPS publique (sans chemin ni identifiants).
# Le workflow sync-sports.yml doit être sur main pour exécuter ses horaires UTC.
# ALLSPORTS_API_KEY doit être configurée dans Vercel ; quota partagé via SyncLog.
# Le cron s'arrête à 80 appels/24h pour garder au moins 20 appels manuels.

# ---------------------------------------------------------------------------
# Outils locaux, tests et variables injectées par la plateforme
# ---------------------------------------------------------------------------
# Ces variables ne sont pas nécessaires à l'application déployée : elles
# pilotent les scripts `scripts/check-*.cjs`, Playwright ou Prisma Studio.

# Injectées par la plateforme d'exécution — ne pas les forcer dans .env :
#   NODE_ENV   « production » sur Vercel, « development » avec `next dev` ;
#              Next.js l'utilise aussi pour choisir le dossier de build
#              (.next-production en production, voir next.config.ts).
#   VERCEL     « 1 » dans les fonctions Vercel ; lue par le code pour adapter
#              le stockage des images et les URLs absolues.
#   CI         « true » dans GitHub Actions ; active les retries Playwright et
#              interdit la réutilisation d'un serveur déjà lancé.
# NODE_ENV="production"
# VERCEL="1"
# CI="true"

# Port du serveur Next.js attendu par les suites de vérification (défaut 3002
# pour la plupart, 3000 pour quelques anciennes suites). `npm run dev` écoute
# sur le port choisi par Next (3000 par défaut) : lancer `PORT=3002 npm run dev`
# ou `npm run dev -- -p 3002` avant les suites.
# PORT="3002"

# Port des serveurs factices Resend/Stripe utilisés par les suites WP11b à
# WP11e (défaut 3100). Aucun service externe n'est appelé.
# STUB_PORT="3100"

# « 1 » : les suites `check-wp8d.cjs` et `check-wp9.cjs` vérifient le build de
# production (démarrage via `npm start`) au lieu du serveur de développement.
# PROD=""

# Navigateur ouvert par Prisma Studio (défaut « none » : aucun). Utile pour
# éviter un onglet surgissant à chaque `npm run db:studio`.
# BROWSER="none"

# Port de Prisma Studio (défaut 5555).
# STUDIO_PORT="5555"

# URL de base des tests Playwright (défaut http://localhost:3002). Doit inclure
# le port utilisé par le serveur, que Playwright démarre s'il ne tourne pas.
# PLAYWRIGHT_BASE_URL="http://localhost:3002"

# Identifiants d'un compte de test pour les pages authentifiées de
# `check-wp13c.cjs`. Jamais un compte de production.
# WP13C_TEST_EMAIL=""
# WP13C_TEST_PASSWORD=""

# URLs de base des suites `check-wp13d.cjs`, `check-wp13e.cjs` et
# `check-wp15a.cjs` (défaut http://127.0.0.1:3002). `check-wp13e.cjs` impose
# le port 3002.
# WP13D_BASE_URL="http://127.0.0.1:3002"
# WP13E_BASE_URL="http://127.0.0.1:3002"
# WP15A_BASE_URL="http://127.0.0.1:3002"

# SITE_URL est une variable GitHub Actions (workflow sync-sports.yml), pas un
# secret ni une variable lue par l'application : adresse HTTPS publique sans
# chemin ni identifiants.
